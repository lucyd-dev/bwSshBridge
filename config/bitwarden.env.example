# Copy to config/bitwarden.env (gitignored) and fill in.
# Create an API key in the Bitwarden web vault (EU region):
#   Account settings -> Security -> Keys -> API key -> View API key
#
# BW_SERVER: EU accounts use https://vault.bitwarden.eu
BW_SERVER=https://vault.bitwarden.eu
BW_CLIENTID=
BW_CLIENTSECRET=
